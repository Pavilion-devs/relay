# Use a generated unique volume ID; this is not a credential.
RELAY_VOLUME_ID=replace-before-initialization
# Use the local content-addressed image ID for rehearsal or a registry digest on AWS.
RELAY_IMAGE=sha256:replace-with-built-image-id
RELAY_PORT=8765
# Cloud deployment requires a reviewed private, encrypted backup bucket.
RELAY_REQUIRE_REMOTE_BACKUP=1
RELAY_BACKUP_BUCKET=
RELAY_BACKUP_PREFIX=relay
# No model or email calls are enabled by default.
RELAY_MODEL_ID=
RELAY_COGNITO_ISSUER=
RELAY_COGNITO_CLIENT_ID=
RELAY_COGNITO_DOMAIN=
RELAY_LOGIN_CALLBACK=http://localhost:8765/identity/callback
